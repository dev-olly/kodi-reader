# Public client configuration only. Never place server/service-role secrets here.
KODI_SUPABASE_URL=
KODI_SUPABASE_PUBLISHABLE_KEY=
KODI_AI_BASE_URL=https://kodi-reader-ai.fly.dev/v1
KODI_GOOGLE_CLIENT_ID=
# Optional value issued with a Google OAuth "Desktop app" client. Desktop apps
# are public clients; this installed-app value is distributed with the app.
# Never use a web-server secret, service-account JSON, or private API key here.
KODI_GOOGLE_CLIENT_SECRET=
KODI_PAYMENTS_ENABLED=NO
# Local development may use an installed FFmpeg; release builds bundle a verified codec.
KODI_FFMPEG_PATH=
