{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the trusted application interface may operate the library and native services.",
  "webviews": [
    "main-ui"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-library-get",
    "allow-import-documents",
    "allow-book-rename",
    "allow-book-delete",
    "allow-library-save-book",
    "allow-settings-save",
    "allow-read-activity",
    "allow-publication-get",
    "allow-media-read",
    "allow-media-url",
    "allow-open-book",
    "allow-reader-bounds",
    "allow-reader-action",
    "allow-sketch-load",
    "allow-sketch-save",
    "allow-sketch-open",
    "allow-export-notes",
    "allow-source-url-import",
    "allow-auth-status",
    "allow-auth-send-code",
    "allow-auth-verify-code",
    "allow-auth-sign-out",
    "allow-auth-delete-account",
    "allow-ai-chat",
    "allow-ai-cancel",
    "allow-drive-status",
    "allow-drive-connect",
    "allow-drive-sync",
    "allow-drive-disconnect",
    "allow-audio-record-start",
    "allow-audio-record-pause",
    "allow-audio-record-finish",
    "allow-audio-play",
    "allow-audio-stop",
    "allow-audio-transcribe",
    "allow-narration-start",
    "allow-narration-pause",
    "allow-narration-update",
    "allow-narration-seek",
    "allow-narration-stop",
    "allow-models-status",
    "allow-models-install",
    "allow-updates-check",
    "allow-updates-install",
    "allow-open-external",
    "allow-models-remove",
    "core:window:allow-is-focused",
    "allow-audio-pause",
    "allow-audio-seek",
    "allow-audio-position",
    "allow-audio-export",
    "core:window:allow-destroy",
    "allow-ai-credits",
    "allow-ai-credit-packs",
    "allow-ai-checkout",
    "allow-ai-purchase-status"
  ]
}
