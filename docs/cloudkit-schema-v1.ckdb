DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE KodiEntity (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        "schemaVersion" INT64,
        "bookID" STRING,
        "kind" STRING,
        "deleted" INT64,
        "payload" BYTES,
        "payloadBlob" BYTES,
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator",
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE KodiAssetRoot (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        "bookID" STRING,
        "scope" STRING,
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator",
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE KodiAssetGroup (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        "parent" REFERENCE,
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator",
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE KodiChunk (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        "hash" STRING,
        "file" ASSET,
        "parent" REFERENCE,
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator",
        GRANT WRITE TO "_creator"
    );
