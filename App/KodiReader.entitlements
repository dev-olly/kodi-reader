<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- WKWebView's content process refuses to launch inside the sandbox
	     without this, even though every resource is served locally from the
	     EPUB by our own scheme handler and nothing touches the network. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Books are opened through the open panel; the security-scoped bookmark
	     saved alongside each one is what allows reopening it on next launch. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
